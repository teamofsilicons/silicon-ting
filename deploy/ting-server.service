[Unit]
Description=Silicon Ting notification service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=ting
Group=ting
WorkingDirectory=/var/lib/ting
EnvironmentFile=/etc/ting/runtime.env
ExecStart=/opt/ting/current/ting-server
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ting
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
