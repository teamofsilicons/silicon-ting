# Registered Silicon Accounts app credentials and Space Station credentials stay server-side.
TING_BIND=127.0.0.1:8080
TING_DATABASE_PATH=ting.sqlite
TING_PUBLIC_ORIGIN=http://127.0.0.1:8080
TING_FRONTEND_ORIGIN=http://127.0.0.1:5173
# Additional exact browser origins, comma-separated; no wildcard or paths.
TING_BROWSER_ORIGINS=https://dm.teamofsilicons.com,https://interface.teamofsilicons.com
TING_ENCRYPTION_KEY=
TING_ACCOUNTS_URL=https://accounts.teamofsilicons.com
TING_ACCOUNTS_APP_SECRET=
TING_ACCOUNTS_WEBHOOK_SECRET=
TING_APPS_URL=https://apps.teamofsilicons.com
TING_SPACESTATION_URL=https://backend.spacestation.teamofsilicons.com
TING_SPACESTATION_TABLE=tingbackend
TING_SPACESTATION_KEY=
TING_TELEMETRY_CLI_KEY=
TING_TELEMETRY_ANALYTICS_KEY=
TING_TELEMETRY_EVENTS_KEY=
TING_DOCS_URL=http://127.0.0.1:5173/docs
RUST_LOG=info
